---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PaperEntry from '../components/PaperEntry.astro';

const allPapers = await getCollection('research');
const bySortOrder = (a, b) => a.data.sortOrder - b.data.sortOrder;

const featured = allPapers.filter(p => p.data.featured).sort(bySortOrder);

// Featured papers surface only in "Selected Work" — exclude them from their
// status sections below so they aren't listed twice.
const byStatus = (status) =>
  allPapers.filter(p => !p.data.featured && p.data.status === status).sort(bySortOrder);

const sections = [
  { title: 'Selected Working Papers', papers: featured },
  { title: 'Whitepaper', papers: byStatus('Whitepaper') },
  { title: 'Publications', papers: byStatus('Published') },
  { title: 'Other Working Papers', papers: byStatus('Working Paper') },
].filter(section => section.papers.length > 0);
---

<BaseLayout
  title="Research - Dingyue (Kite) Liu"
  description="Research papers and publications on DeFi, blockchain economics, decentralized exchanges, and market design."
>
  <div class="container mx-auto px-4 py-12 md:py-16 max-w-4xl">
    <header class="mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        Research
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">
        Research papers, publications, and working papers on decentralized finance,
        blockchain economics, and market design for decentralized exchanges.
      </p>
    </header>

    {sections.map((section) => (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 pb-2 border-b border-gray-200 dark:border-gray-700">
          {section.title}
        </h2>
        <div class="space-y-6">
          {section.papers.map((paper) => (
            <PaperEntry paper={paper} />
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
