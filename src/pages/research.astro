---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPapers = await getCollection('research');

const published = allPapers
  .filter(p => p.data.status === 'Published')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const workingPapers = allPapers
  .filter(p => p.data.status === 'Working Paper')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const whitepapers = allPapers
  .filter(p => p.data.status === 'Whitepaper')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Research - Dingyue (Kite) Liu"
  description="Research papers and publications on DeFi, blockchain economics, decentralized exchanges, and market design."
>
  <div class="container mx-auto px-4 py-12 md:py-16 max-w-4xl">
    <header class="mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        Research
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">
        Research papers, publications, and working papers on decentralized finance,
        blockchain economics, and market design for decentralized exchanges.
      </p>
    </header>

    {published.length > 0 && (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 pb-2 border-b border-gray-200 dark:border-gray-700">
          Publications
        </h2>
        <div class="space-y-8">
          {published.map((paper) => (
            <article>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">
                {paper.data.pdfUrl ? (
                  <a
                    href={paper.data.pdfUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors underline decoration-gray-300 dark:decoration-gray-600 underline-offset-2 hover:decoration-blue-600 dark:hover:decoration-blue-400"
                  >
                    {paper.data.title}
                  </a>
                ) : (
                  paper.data.title
                )}
              </h3>
              <p class="text-sm text-gray-600 dark:text-gray-400 mb-1">
                {paper.data.authors}
              </p>
              {paper.data.venue && (
                <p class="text-sm text-gray-500 dark:text-gray-500 italic mb-2">
                  {paper.data.venue}
                </p>
              )}
              <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
                {paper.data.description}
              </p>
            </article>
          ))}
        </div>
      </section>
    )}

    {workingPapers.length > 0 && (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 pb-2 border-b border-gray-200 dark:border-gray-700">
          Working Papers
        </h2>
        <div class="space-y-8">
          {workingPapers.map((paper) => (
            <article>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">
                {paper.data.pdfUrl ? (
                  <a
                    href={paper.data.pdfUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors underline decoration-gray-300 dark:decoration-gray-600 underline-offset-2 hover:decoration-blue-600 dark:hover:decoration-blue-400"
                  >
                    {paper.data.title}
                  </a>
                ) : (
                  paper.data.title
                )}
              </h3>
              <p class="text-sm text-gray-600 dark:text-gray-400 mb-1">
                {paper.data.authors}
              </p>
              <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
                {paper.data.description}
              </p>
            </article>
          ))}
        </div>
      </section>
    )}

    {whitepapers.length > 0 && (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 pb-2 border-b border-gray-200 dark:border-gray-700">
          Whitepaper
        </h2>
        <div class="space-y-8">
          {whitepapers.map((paper) => (
            <article>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">
                {paper.data.pdfUrl ? (
                  <a
                    href={paper.data.pdfUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors underline decoration-gray-300 dark:decoration-gray-600 underline-offset-2 hover:decoration-blue-600 dark:hover:decoration-blue-400"
                  >
                    {paper.data.title}
                  </a>
                ) : (
                  paper.data.title
                )}
              </h3>
              <p class="text-sm text-gray-600 dark:text-gray-400 mb-1">
                {paper.data.authors}
              </p>
              {paper.data.venue && (
                <p class="text-sm text-gray-500 dark:text-gray-500 italic mb-2">
                  {paper.data.venue}
                </p>
              )}
              <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
                {paper.data.description}
              </p>
            </article>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
