---
import BaseLayout from '../layouts/BaseLayout.astro';

const cards = [
  {
    title: 'Research',
    href: '/research',
    description: 'Papers, publications, and working papers on DeFi and market design.',
  },
  {
    title: 'Projects',
    href: '/projects',
    description: 'Interactive tools, data explorations, and workshops.',
  },
  {
    title: 'Fun',
    href: '/fun',
    description: 'Concerts, vlogs, and moments outside the lab.',
  },
];
---

<BaseLayout title="Dingyue (Kite) Liu - Senior Research Scientist">
	<section class="hero-section container mx-auto px-4 pt-20 pb-12 md:pt-28 md:pb-16">
		<div class="max-w-4xl mx-auto text-center">
			<h1 class="hero-title text-4xl md:text-6xl lg:text-7xl font-bold mb-6">
				<span class="block text-gray-900 dark:text-white">Hi, I'm</span>
				<span class="block gradient-text">Dingyue (Kite) Liu</span>
			</h1>

			<p class="hero-subtitle text-xl md:text-2xl text-gray-600 dark:text-gray-400 mb-8 animate-fade-in-up">
				Senior Research Scientist at Uniswap Labs
			</p>

			<p class="text-lg text-gray-700 dark:text-gray-300 mb-12 max-w-2xl mx-auto animate-fade-in-up-delay">
				Exploring how people decide, onchain and off.
			</p>

			<div class="flex flex-wrap gap-4 justify-center animate-fade-in-up-delay-2">
				<a
					href="/research"
					class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors"
				>
					View Research
				</a>
				<a
					href="https://www.linkedin.com/in/kiteliudingyue/"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 px-6 py-3 border border-gray-300 dark:border-gray-700 text-gray-900 dark:text-white font-medium rounded-lg hover:border-blue-600 dark:hover:border-blue-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
				>
					<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
					</svg>
					Connect on LinkedIn
				</a>
			</div>
		</div>
	</section>

	<section class="container mx-auto px-4 pb-20 md:pb-28">
		<div class="grid gap-6 md:grid-cols-3 max-w-5xl mx-auto animate-fade-in-up-delay-2">
			{cards.map((card) => (
				<a
					href={card.href}
					class="group flex flex-col border border-gray-200 dark:border-gray-700 rounded-lg p-6 hover:border-blue-400 dark:hover:border-blue-500 transition-colors"
				>
					<div class="flex items-center justify-between mb-2">
						<h2 class="text-xl font-semibold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
							{card.title}
						</h2>
						<svg class="w-5 h-5 text-gray-400 dark:text-gray-500 flex-shrink-0 transition-transform group-hover:translate-x-1 group-hover:text-blue-600 dark:group-hover:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
						</svg>
					</div>
					<p class="text-gray-600 dark:text-gray-400 leading-relaxed">
						{card.description}
					</p>
				</a>
			))}
		</div>
	</section>
</BaseLayout>

<style>
	.gradient-text {
		background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		animation: gradient-shift 3s ease infinite;
		/* text-7xl ships line-height:1, which clips descenders (g, y) under
		   background-clip:text — add room below the baseline. */
		line-height: 1.15;
		padding-bottom: 0.12em;
	}

	@keyframes gradient-shift {
		0%, 100% {
			background-position: 0% 50%;
		}
		50% {
			background-position: 100% 50%;
		}
	}

	.hero-title {
		animation: fade-in-down 0.8s ease-out;
	}

	@keyframes fade-in-down {
		from {
			opacity: 0;
			transform: translateY(-20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.animate-fade-in-up {
		animation: fade-in-up 0.8s ease-out 0.2s both;
	}

	.animate-fade-in-up-delay {
		animation: fade-in-up 0.8s ease-out 0.4s both;
	}

	.animate-fade-in-up-delay-2 {
		animation: fade-in-up 0.8s ease-out 0.6s both;
	}

	@keyframes fade-in-up {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
