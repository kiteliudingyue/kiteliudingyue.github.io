---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ConcertCard from '../components/ConcertCard';
import Squiggle from '../components/Squiggle.astro';

const allConcerts = await getCollection('concerts');

// Sort by date (newest first), with featured concerts at the top
const sortedConcerts = allConcerts.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});

// Get all unique tags
const allTags = [...new Set(allConcerts.flatMap(concert => concert.data.tags))].sort();

const vlogs = [
  {
    title: 'Ball Crew at Indian Wells',
    description: 'My experience working as ball crew at the BNP Paribas Open in Indian Wells.',
    embedUrl: 'https://player.bilibili.com/player.html?bvid=BV16S4y127FQ&autoplay=0',
    platform: 'bilibili' as const,
  },
  {
    title: 'Zoom Era Games with Friends',
    description: 'Fun and games with friends during the remote work era.',
    embedUrl: 'https://player.bilibili.com/player.html?bvid=BV16C4y1b7u3&autoplay=0',
    platform: 'bilibili' as const,
  },
  {
    title: 'Video Production for Purdue RecWell',
    description: 'A video I produced for Purdue Recreational Sports.',
    embedUrl: 'https://player.bilibili.com/player.html?bvid=BV1xK41157Vr&autoplay=0',
    platform: 'bilibili' as const,
  },
];
---

<BaseLayout
  title="Fun - Dingyue (Kite) Liu"
  description="Personal interests, concert memories, and fun experiences."
>
  <div class="container mx-auto px-4 py-12 md:py-16">
    <header class="max-w-3xl mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        Fun & Personal
      </h1>
      <Squiggle width={120} class="mb-5 -mt-2" />
      <p class="text-lg text-gray-600 dark:text-gray-400">
        Here's a few moments from some of the concerts I've been to. Hover over cards (or tap on mobile) to watch short video clips and click the speaker to hear the audio.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6">
      {sortedConcerts.map((concert) => (
        <ConcertCard concert={concert} client:visible />
      ))}
    </div>

    {sortedConcerts.length === 0 && (
      <div class="text-center py-16">
        <p class="text-gray-500 dark:text-gray-400 text-lg">
          No concerts yet. Check back soon!
        </p>
      </div>
    )}

    {sortedConcerts.length > 0 && (
      <footer class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-800">
        <p class="text-sm text-gray-500 dark:text-gray-400 text-center max-w-2xl mx-auto">
          <strong>Note:</strong> These short clips are from concerts I personally attended, shared for personal memories and archival purposes.
        </p>
      </footer>
    )}

    {vlogs.length > 0 && (
      <section class="mt-20">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
          Vlogs
        </h2>
        <Squiggle width={90} class="mb-4 -mt-1" />
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-10 max-w-3xl">
          Longer videos from travels, events, and everyday life.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl">
          {vlogs.map((vlog) => (
            <article class="group">
              <div class="relative aspect-video rounded-lg overflow-hidden border border-gray-200 dark:border-gray-700">
                <iframe
                  src={vlog.embedUrl}
                  title={vlog.title}
                  class="absolute inset-0 w-full h-full"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                />
              </div>
              <h3 class="mt-3 text-lg font-semibold text-gray-900 dark:text-white">
                {vlog.title}
              </h3>
              <p class="mt-1 text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                {vlog.description}
              </p>
            </article>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
