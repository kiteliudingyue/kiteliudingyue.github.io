---
import type { CollectionEntry } from 'astro:content';

interface Props {
  paper: CollectionEntry<'research'>;
}

const { paper } = Astro.props;
const { title, pdfUrl, hook, authors, venue, description } = paper.data;
---

<article>
  <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">
    {pdfUrl ? (
      <a
        href={pdfUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors underline decoration-gray-300 dark:decoration-gray-600 underline-offset-2 hover:decoration-blue-600 dark:hover:decoration-blue-400"
      >
        {title}
      </a>
    ) : (
      title
    )}
  </h3>
  {hook && (
    <p class="text-sm italic text-indigo-600/70 dark:text-indigo-400/70 mb-1">
      {hook}
    </p>
  )}
  {authors.length > 0 && (
    <p class="text-sm text-gray-700 dark:text-gray-300 mb-1">
      with{' '}
      {authors.map((author, i) => (
        <>
          {i > 0 && (i === authors.length - 1 ? ', and ' : ', ')}
          {author.url ? (
            <a
              href={author.url}
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-gray-300 dark:decoration-gray-600 underline-offset-2 hover:text-blue-600 dark:hover:text-blue-400 hover:decoration-blue-600 dark:hover:decoration-blue-400 transition-colors"
            >
              {author.name}
            </a>
          ) : (
            author.name
          )}
        </>
      ))}
    </p>
  )}
  {venue && (
    <p class="text-sm text-gray-500 dark:text-gray-500 italic mb-2">
      {venue}
    </p>
  )}
  <details class="mt-2 group">
    <summary class="text-sm font-medium text-gray-600 dark:text-gray-400 cursor-pointer hover:text-blue-600 dark:hover:text-blue-400 transition-colors select-none">
      Abstract
    </summary>
    <p class="mt-2 text-sm text-gray-700 dark:text-gray-300 leading-relaxed pl-0 whitespace-pre-line">
      {description}
    </p>
  </details>
</article>
